{
  "name": "plenty-map-qa",
  "private": true,
  "type": "module",
  "description": "Automatic quality checks for plentymap.com: layout in every language and size, accessibility, links, visual changes, and listing data.",
  "scripts": {
    "site": "bash build-site.sh _site",
    "serve": "node serve.mjs _site 4173",
    "test": "playwright test",
    "test:quick": "QA_QUICK=1 playwright test --project=layout --project=states --project=a11y",
    "triage": "node scripts/triage.mjs",
    "data": "node scripts/data-checks.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0"
  }
}
